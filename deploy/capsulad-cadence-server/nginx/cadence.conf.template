upstream cadence {
  server cadence:8080;
}

upstream cadence_dashboard {
  server dashboard:3000;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

map $ssl_client_verify $client_cert_ok {
  default 0;
  SUCCESS 1;
}

server {
  listen ${CADENCE_PORT} ssl;
  http2 on;
  server_name _;

  ssl_certificate     /certs/server.crt;
  ssl_certificate_key /certs/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;

  client_max_body_size 4m;

  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_read_timeout 1h;
  proxy_send_timeout 1h;

  location /v2/ { proxy_pass http://cadence; }
  location /api/    { proxy_pass http://cadence; }
  location = /healthz { proxy_pass http://cadence; }

  location / { proxy_pass http://cadence_dashboard; }
}