#!/bin/sh
# Framework-owned boot service for the Rockchip stock image.
#
# Deployed as /etc/init.d/S60capsulad (no .sh suffix: rcS executes such scripts
# directly, while *.sh files are sourced into a subshell). It starts after
# S02mount-data, S50mic-enable and S50pulseaudio.
#
# The vendor assistant chain (S97voice-agent.sh, S99sysmon.sh) must be retired;
# this service supersedes those processes at runtime, and booting both stacks
# would make two processes fight over /dev/input/event0 and /dev/watchdog.
#
# `capsulad -health` exit codes:
#   0  framework API answers
#   1  no daemon / not serving
#   2  this binary predates -health (the first upgrade); trust the process
#
# If the daemon cannot become healthy the script starts the preserved vendor
# chain, so a bad upgrade does not leave the speaker without an assistant.

DIR=/data/capsdemo
CAPSULAD=$DIR/capsulad
SOCKET=$DIR/run/hal.sock
PIDFILE=$DIR/run/capsulad.pid
BOOTLOG=$DIR/boot.log
VENDOR=$DIR/vendor-init/S97voice-agent.sh

log() { echo "$(date '+%Y-%m-%dT%H:%M:%S') capsulad: $*" >>"$BOOTLOG"; }

# Keep the boot log from becoming a second unbounded log file.
if [ -f "$BOOTLOG" ] && [ "$(wc -c <"$BOOTLOG")" -gt 65536 ]; then
    : >"$BOOTLOG"
fi

# This busybox has no `pgrep -x`, and the detached watchdog feeder shares the
# `capsulad` process name. Match the daemon by comm plus cmdline, never by
# name alone: killing the feeder can reset the board once the timer is armed.
is_daemon() {
    [ -n "$1" ] && [ -d "/proc/$1" ] || return 1
    [ "$(cat "/proc/$1/comm" 2>/dev/null)" = "capsulad" ] || return 1
    case "$(tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null)" in
    *__capsula_watchdog_feeder*) return 1 ;;
    esac
    return 0
}

daemon_pids() {
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if is_daemon "$pid"; then
        echo "$pid"
        return 0
    fi
    for pid in $(pgrep capsulad 2>/dev/null); do
        is_daemon "$pid" && echo "$pid"
    done
}

running() { [ -n "$(daemon_pids)" ]; }

probe() {
    "$CAPSULAD" -health -socket "$SOCKET" >/dev/null 2>&1
    return $?
}

stop() {
    pids=$(daemon_pids)
    if [ -z "$pids" ]; then
        return 0
    fi
    for pid in $pids; do
        kill -TERM "$pid" 2>/dev/null
    done
    i=0
    while [ $i -lt 15 ]; do
        alive=""
        for pid in $pids; do
            is_daemon "$pid" && alive="$alive $pid"
        done
        [ -z "$alive" ] && return 0
        sleep 1
        i=$((i+1))
    done
    log "SIGTERM did not stop the daemon; sending SIGKILL"
    for pid in $alive; do
        kill -KILL "$pid" 2>/dev/null
    done
    sleep 1
}

# A pre-upgrade binary cannot answer -health; a running process is the best
# available signal for that one transition, never for a normal start.
wait_up() {
    i=0
    while [ $i -lt 20 ]; do
        probe
        case $? in
        0) return 0 ;;
        2) running && return 0 ;;
        esac
        sleep 1
        i=$((i+1))
    done
    return 1
}

start() {
    # The RK3308 routes the Bluetooth UART interrupt to CPU0, which also runs
    # the daemon and the wakeword inference. Under load hci_uart reports
    # framing errors and A2DP drops 100 ms chunks. Move the UART IRQ to CPU3.
    irq_line=$(grep serial /proc/interrupts 2>/dev/null | head -1)
    if [ -n "$irq_line" ]; then
        irq=${irq_line%%:*}
        irq=$(echo "$irq" | tr -d ' ')
        if [ -w "/proc/irq/$irq/smp_affinity" ]; then
            echo 8 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
        fi
    fi
    probe
    case $? in
    0)
        return 0
        ;;
    2)
        running && return 0
        ;;
    esac
    if running; then
        log "a daemon process exists but does not answer; restarting it"
        stop
    fi
    mkdir -p "$DIR/run"
    log "starting $CAPSULAD"
    nohup "$CAPSULAD" -platform rockchip-stock -data-dir "$DIR" \
        -web-addr 0.0.0.0:8443 >>"$BOOTLOG" 2>&1 &
    if wait_up; then
        log "daemon healthy"
        return 0
    fi
    log "daemon did not become healthy; falling back to the vendor assistant"
    stop
    if [ -x "$VENDOR" ]; then
        "$VENDOR" start
    else
        log "vendor fallback $VENDOR is missing"
    fi
    return 1
}

case "$1" in
start) start ;;
stop) stop ;;
restart)
    stop
    start
    ;;
status) probe ;;
*)
    echo "usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
